# "fixture" reads data/gradebook.fixture.json (no network, no credentials)
# "api" calls the Academic API
DATA_SOURCE=fixture
PORT=3000

# Only required when DATA_SOURCE=api
ACADEMIC_API_BASE_URL=
ACADEMIC_API_KEY=
COURSE_ID=

# Optional
# ACADEMIC_API_GRADEBOOK_PATH=/admin/courses/{course_id}/gradebook
# ACADEMIC_API_TIMEOUT_MS=10000
# FIXTURE_PATH=data/gradebook.fixture.json
